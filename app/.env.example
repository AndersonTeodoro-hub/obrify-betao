# Copiar para app/.env.local e preencher. O .env.local não vai para o
# repositório — está no .gitignore da raiz.
#
# A chave ANÓNIMA é pública por natureza: vai dentro do código que corre no
# telemóvel e qualquer pessoa a consegue ler. Quem decide o que ela alcança é a
# RLS e os privilégios do papel anon, que neste projeto são nenhuns.
#
# A chave de SERVICE_ROLE nunca entra aqui, nem em ficheiro nenhum do
# repositório, nem em variável com prefixo VITE_ — tudo o que tem esse prefixo
# é embutido no pacote entregue ao browser.

VITE_SUPABASE_URL=https://<ref-do-projeto>.supabase.co
VITE_SUPABASE_ANON_KEY=<chave anónima do projeto>
